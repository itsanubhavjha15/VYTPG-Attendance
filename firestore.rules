rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // True only for accounts listed in the admins collection (i.e. the principal).
    // A principal document is created manually by you in the Firebase Console —
    // see the instructions that came with this file.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // True only for accounts listed in the creators collection — a superadmin
    // layer above the principal. Granted manually in the Firebase Console
    // (never from the app). Wherever isAdmin() unlocks something below,
    // isCreator() unlocks the same thing, so a creator can do everything a
    // principal can, plus edit any class directly (not just view it).
    function isCreator() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/creators/$(request.auth.uid));
    }
    // True only if the caller is the HoD of the given department. Used to scope
    // masterRosters writes to exactly the one department a given HoD manages.
    function isHodOf(deptId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/hods/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/hods/$(request.auth.uid)).data.departmentId == deptId;
    }    // True if the caller is the owning professor of a class OR is listed in
    // that class's collaboratorIds array. Takes the class doc's data (not the
    // classId) so it can be reused both on the class doc itself (resource.data)
    // and, via get(), on its subcollections.
    function isOwnerOrCollaborator(classData) {
      return request.auth != null &&
        (classData.professorId == request.auth.uid ||
         (classData.collaboratorIds != null && request.auth.uid in classData.collaboratorIds));
    }
    // Parses an attendance_records doc ID ("YYYY-MM-DD") into a Timestamp so
    // the edit-window check below can compare it to request.time. Mirrors the
    // app's own EDIT_WINDOW_DAYS = 7 logic (index.html), which today only
    // enforces this client-side and can be bypassed by any direct API call.
    function dateFromDocId(dateStr) {
      let parts = dateStr.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
    }
    function withinAttendanceEditWindow(dateStr) {
      return request.time < dateFromDocId(dateStr) + duration.value(7, 'd');
    }
    // Each professor (or the principal, if they choose to set one) can read/write
    // only their own admin-flag document — this lets the app check "am I an admin?"
    // without being able to read or grant anyone else's admin status.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // grant admin status only from the Firebase Console, never from the app
    }
    // Same pattern as admins/{uid} above, for the creator superadmin flag —
    // a caller can only ever read their own doc, and it can never be written
    // from the app. Grant it by hand in the Firebase Console: Firestore →
    // create collection "creators" → document ID = that person's Auth UID.
    match /creators/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // grant creator status only from the Firebase Console, never from the app
    }
    // Professors manage their own display name; the principal (and a creator)
    // can read/write everyone's so classes can be labeled with a human name
    // instead of a raw user ID, and so the Add/Edit Professor screen works.
    match /professors/{profId} {
      allow read: if request.auth != null && (request.auth.uid == profId || isAdmin() || isCreator());
      allow write: if request.auth != null && (request.auth.uid == profId || isAdmin() || isCreator());
    }

    // Lightweight public directory of display names only — lets any signed-in
    // professor browse/list colleagues (e.g. the "share class" collaborator
    // picker) without exposing email/phone from the full professors/{uid} doc,
    // which stays locked down to self + admin/creator. The app keeps this in
    // sync whenever a professor's displayName is set/edited/removed.
    match /professorNames/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin() || isCreator());
    }

    // Departments & Courses catalog — every logged-in professor can read (needed
    // to populate the dropdowns and cross-professor "existing classes" chips when
    // adding a class), but only the principal or a creator can add/edit/delete entries.
    match /departments/{deptId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdmin() || isCreator());
    }
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdmin() || isCreator());
    }

    // HoD assignments — a professor (or anyone) can read only their own doc, to
    // check "am I an HoD, and of which department". The principal and a
    // creator can read all (to build the Manage HoDs screen) and are the only
    // ones who can write — assignment/removal always goes through that app UI.
    match /hods/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isCreator());
      allow write: if request.auth != null && (isAdmin() || isCreator());
    }

    // Batch Incharge assignments — one doc per uid, same shape as hods/{uid}
    // above, but scoped one level down: a batch (a set of combined sections
    // within one course) rather than a whole department. Unlike hods
    // assignments (principal/creator only), a Batch Incharge is assigned by
    // that batch's own Department Incharge (isHodOf the batch's
    // departmentId) — so the write rules check both the incoming and (for
    // update) the existing doc's departmentId, to stop one department's
    // Incharge from reassigning or overwriting another department's
    // Batch Incharge doc for the same professor.
    match /batchIncharges/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAdmin() || isCreator() || isHodOf(resource.data.departmentId));
      allow create: if request.auth != null &&
        (isAdmin() || isCreator() || isHodOf(request.resource.data.departmentId));
      allow update: if request.auth != null &&
        (isAdmin() || isCreator() ||
         (isHodOf(request.resource.data.departmentId) && isHodOf(resource.data.departmentId)));
      allow delete: if request.auth != null &&
        (isAdmin() || isCreator() || isHodOf(resource.data.departmentId));
    }

    // Master rosters — one doc per (department_course_section) triple, holding
    // the full student list a Section Incharge (HoD) uploaded. Any logged-in
    // professor can read (needed to fetch it into their own class — rosters
    // are shared department-wide across every course for a matching section),
    // but only the Section Incharge of that exact department, the principal,
    // or a creator can create/update/delete it. The one exception is
    // "sectionKey": any authenticated professor may add/fix that single field
    // (and nothing else) — the app backfills it on older roster docs the
    // first time they're fetched, so department-wide lookups find them
    // without requiring the Section Incharge to re-upload.
    match /masterRosters/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        (isAdmin() || isCreator() || isHodOf(request.resource.data.departmentId));
      allow update: if request.auth != null &&
        (isAdmin() || isCreator() || isHodOf(resource.data.departmentId) ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sectionKey']) &&
          request.resource.data.sectionKey is string &&
          request.resource.data.sectionKey.size() > 0));
      allow delete: if request.auth != null &&
        (isAdmin() || isCreator() || isHodOf(resource.data.departmentId));
    }

    // Audit log — a record of admin actions (deletions, professor account
    // changes, Section Incharge assignments), written by the app whenever
    // such an action happens. Any signed-in user can create an entry for an
    // action THEY performed (so a professor deleting their own class still
    // gets logged, not just principal/creator actions) — but only the
    // principal or a creator can read the log, and entries can never be
    // edited or deleted once written, so it's a genuine trail.
    match /auditLog/{id} {
      allow read: if request.auth != null && (isAdmin() || isCreator());
      allow create: if request.auth != null &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.action is string &&
        request.resource.data.createdAt == request.time; // must be FieldValue.serverTimestamp(), not a client-supplied time
      allow update, delete: if false;
    }

    // Deletion backups — a full snapshot of a class (its own doc + students +
    // attendance_records) taken automatically right before it's deleted, so
    // a deleted class can be brought back if the deletion was a mistake.
    // Anyone who can legitimately delete a class (its owner, principal, or
    // creator) can also write its backup — the backup write always happens
    // as part of that same delete action, never on its own.
    //   Restore tiering:
    //   - The professor who deleted it (deletedBy) can read/restore/delete
    //     their OWN backup for 7 days after deletion — self-service, no
    //     admin needed, for the common "oops" case.
    //   - After 7 days, only the principal/creator can read or delete it
    //     (via the Audit Log's Restore button) — later restores go through
    //     an admin on purpose, since the deleting professor no longer gets
    //     an easy one-tap undo.
    //   - Any signed-in professor may delete an already-EXPIRED backup
    //     (expiresAt has passed) regardless of who created it — this is
    //     what lets cleanupExpiredBackups() (run client-side on login,
    //     standing in for Firestore TTL, which needs the paid Blaze plan)
    //     sweep expired backups no matter who happens to be logged in.
    function ownsRecentBackup() {
      return resource.data.deletedBy == request.auth.uid &&
        resource.data.deletedAt is timestamp &&
        resource.data.deletedAt > request.time - duration.value(7, 'd');
    }
    match /deletedClassBackups/{backupId} {
      allow read: if request.auth != null && (isAdmin() || isCreator() || ownsRecentBackup());
      allow create: if request.auth != null &&
        request.resource.data.deletedBy == request.auth.uid &&
        request.resource.data.deletedAt == request.time && // must be FieldValue.serverTimestamp()
        request.resource.data.expiresAt is timestamp &&
        // The class must still exist at backup time (it's snapshotted right
        // before deletion) and the caller must actually be allowed to delete
        // it — otherwise anyone signed in could fabricate a backup doc with
        // arbitrary made-up contents.
        (get(/databases/$(database)/documents/classes/$(request.resource.data.originalClassId)).data.professorId == request.auth.uid ||
         isAdmin() || isCreator());
      allow update: if false;
      allow delete: if request.auth != null &&
        (isAdmin() || isCreator() || ownsRecentBackup() ||
         (resource.data.expiresAt is timestamp && resource.data.expiresAt <= request.time));
    }

    // Cached institution-wide stats (currently just the unique-student count
    // shown on the Principal Dashboard). Recomputing it needs a full fan-out
    // across every class's students subcollection, so the app only does that
    // once per calendar day and caches the result here — read on every
    // principal/creator login, written only when it actually recomputes.
    match /institutionStats/{docId} {
      allow read, write: if request.auth != null && (isAdmin() || isCreator());
    }

    match /classes/{classId} {
      // Any logged-in professor can read class metadata (name, department, course,
      // lecture count) — needed so the "existing classes under this course" picker
      // works across professors. Student rosters and attendance records below
      // remain fully restricted to the owning professor, a collaborator, the
      // principal, or a creator.
      allow read: if request.auth != null;
      // Collaborators can edit the class (e.g. lecture count, syllabus meta)
      // just like the owner; the principal and a creator can too — but a
      // plain collaborator may NOT change professorId (would let them steal
      // ownership) or collaboratorIds (would let them add/remove sharing —
      // the app's UI only exposes "Share Class" to the owner/creator, so the
      // rule now matches that). Only the current owner, admin, or creator can
      // touch either of those two fields.
      allow update: if request.auth != null && (
        isAdmin() || isCreator() ||
        (isOwnerOrCollaborator(resource.data) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['professorId','collaboratorIds'])) ||
        (resource.data.professorId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaboratorIds'])) ||
        // Department Incharge correcting/assigning which batch a class
        // belongs to (the "Move to different batch" tool) — scoped to only
        // that one field, on a class within their own department.
        (isHodOf(resource.data.departmentId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['batchLabelOverride']))
      );
      // Only the owning professor, the principal, or a creator can delete
      // the class outright.
      allow delete: if request.auth != null &&
        (resource.data.professorId == request.auth.uid || isAdmin() || isCreator());
      // A professor can create a class for themselves; the principal or a
      // creator can create one on behalf of any professor (used by the
      // "Add Subject" flow opened from a professor's page in the Principal
      // dashboard).
      allow create: if request.auth != null &&
        (request.resource.data.professorId == request.auth.uid || isAdmin() || isCreator());
      match /students/{studentId} {
        allow read, write: if isOwnerOrCollaborator(
          get(/databases/$(database)/documents/classes/$(classId)).data) || isAdmin() || isCreator();
      }
      match /attendance_records/{dateStr} {
        allow read: if isOwnerOrCollaborator(
          get(/databases/$(database)/documents/classes/$(classId)).data) || isAdmin() || isCreator();
        // Creating a record (first-time marking of a date, or restoring a
        // previously-deleted class from its backup) is unrestricted by date —
        // only editing/deleting a record that already exists is subject to
        // the 7-day window, so historical attendance can't be quietly
        // rewritten after the fact by anyone but the principal/creator.
        // submittedBy, when present, must name the actual caller — otherwise
        // a collaborator could falsely attribute a submission to someone else.
        allow create: if (isOwnerOrCollaborator(
          get(/databases/$(database)/documents/classes/$(classId)).data) || isAdmin() || isCreator()) &&
          (request.resource.data.submittedBy == null || request.resource.data.submittedBy.uid == request.auth.uid);
        allow update: if (isAdmin() || isCreator() ||
          (isOwnerOrCollaborator(get(/databases/$(database)/documents/classes/$(classId)).data) &&
           withinAttendanceEditWindow(dateStr))) &&
          (request.resource.data.submittedBy == null || request.resource.data.submittedBy.uid == request.auth.uid);
        allow delete: if isAdmin() || isCreator() ||
          (isOwnerOrCollaborator(get(/databases/$(database)/documents/classes/$(classId)).data) &&
           withinAttendanceEditWindow(dateStr));
      }
      match /syllabus/{topicId} {
        allow read, write: if isOwnerOrCollaborator(
          get(/databases/$(database)/documents/classes/$(classId)).data) || isAdmin() || isCreator();
      }
    }

    // Public attendance view — lets a student check their own attendance with
    // no account at all. Each doc is keyed by "{RollNumber}_{last 5 phone
    // digits}" (built client-side, case-sensitive on the roll number), so a
    // read only succeeds if the caller already knows both pieces. `list` is
    // denied so the collection can never be browsed/enumerated wholesale —
    // only a single, already-known doc ID can be fetched. Writes happen only
    // from the app when a signed-in professor adds a student or submits
    // attendance, never from a student.
    match /publicView/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null;
    }

    // College notice board — announcements any signed-in professor can post,
    // readable by everyone (including signed-out visitors on the public home
    // screen). A professor may edit/delete only their own post; the principal
    // and a creator can moderate (delete) any of them. The ackCount-only
    // clause lets any visitor — including signed-out students — tap "Got it"
    // and bump the counter by exactly one, without being able to touch any
    // other field.
    match /announcements/{id} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid;
      allow update: if
        (request.auth != null && (resource.data.authorUid == request.auth.uid || isAdmin() || isCreator())) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackCount']) &&
         request.resource.data.ackCount == (resource.data.ackCount == null ? 0 : resource.data.ackCount) + 1);
      allow delete: if request.auth != null &&
        (resource.data.authorUid == request.auth.uid || isAdmin() || isCreator());
    }
  }
}
