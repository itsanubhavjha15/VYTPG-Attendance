rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // True only for accounts listed in the admins collection (i.e. the principal).
    // A principal document is created manually by you in the Firebase Console —
    // see the instructions that came with this file.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // True only for accounts listed in the creators collection — a superadmin
    // layer above the principal. Granted manually in the Firebase Console
    // (never from the app). Wherever isAdmin() unlocks something below,
    // isCreator() unlocks the same thing, so a creator can do everything a
    // principal can, plus edit any class directly (not just view it).
    function isCreator() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/creators/$(request.auth.uid));
    }
    // True only if the caller is the HoD of the given department. Used to scope
    // masterRosters writes to exactly the one department a given HoD manages.
    function isHodOf(deptId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/hods/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/hods/$(request.auth.uid)).data.departmentId == deptId;
    }
    // True if the caller is the owning professor of a class OR is listed in
    // that class's collaboratorIds array. Takes the class doc's data (not the
    // classId) so it can be reused both on the class doc itself (resource.data)
    // and, via get(), on its subcollections.
    function isOwnerOrCollaborator(classData) {
      return request.auth != null &&
        (classData.professorId == request.auth.uid ||
         (classData.collaboratorIds != null && request.auth.uid in classData.collaboratorIds));
    }
    // Each professor (or the principal, if they choose to set one) can read/write
    // only their own admin-flag document — this lets the app check "am I an admin?"
    // without being able to read or grant anyone else's admin status.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // grant admin status only from the Firebase Console, never from the app
    }
    // Same pattern as admins/{uid} above, for the creator superadmin flag —
    // a caller can only ever read their own doc, and it can never be written
    // from the app. Grant it by hand in the Firebase Console: Firestore →
    // create collection "creators" → document ID = that person's Auth UID.
    match /creators/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // grant creator status only from the Firebase Console, never from the app
    }
    // Professors manage their own display name; the principal (and a creator)
    // can read/write everyone's so classes can be labeled with a human name
    // instead of a raw user ID, and so the Add/Edit Professor screen works.
    match /professors/{profId} {
      allow read: if request.auth != null && (request.auth.uid == profId || isAdmin() || isCreator());
      allow write: if request.auth != null && (request.auth.uid == profId || isAdmin() || isCreator());
    }

    // Lightweight public directory of display names only — lets any signed-in
    // professor browse/list colleagues (e.g. the "share class" collaborator
    // picker) without exposing email/phone from the full professors/{uid} doc,
    // which stays locked down to self + admin/creator. The app keeps this in
    // sync whenever a professor's displayName is set/edited/removed.
    match /professorNames/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin() || isCreator());
    }

    // Departments & Courses catalog — every logged-in professor can read (needed
    // to populate the dropdowns and cross-professor "existing classes" chips when
    // adding a class), but only the principal or a creator can add/edit/delete entries.
    match /departments/{deptId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdmin() || isCreator());
    }
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdmin() || isCreator());
    }

    // HoD assignments — a professor (or anyone) can read only their own doc, to
    // check "am I an HoD, and of which department". The principal and a
    // creator can read all (to build the Manage HoDs screen) and are the only
    // ones who can write — assignment/removal always goes through that app UI.
    match /hods/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isCreator());
      allow write: if request.auth != null && (isAdmin() || isCreator());
    }

    // Master rosters — one doc per (department_course_section) triple, holding
    // the full student list a Section Incharge (HoD) uploaded. Any logged-in
    // professor can read (needed to fetch it into their own class — rosters
    // are shared department-wide across every course for a matching section),
    // but only the Section Incharge of that exact department, the principal,
    // or a creator can create/update/delete it. The one exception is
    // "sectionKey": any authenticated professor may add/fix that single field
    // (and nothing else) — the app backfills it on older roster docs the
    // first time they're fetched, so department-wide lookups find them
    // without requiring the Section Incharge to re-upload.
    match /masterRosters/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        (isAdmin() || isCreator() || isHodOf(request.resource.data.departmentId));
      allow update: if request.auth != null &&
        (isAdmin() || isCreator() || isHodOf(resource.data.departmentId) ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sectionKey']));
      allow delete: if request.auth != null &&
        (isAdmin() || isCreator() || isHodOf(resource.data.departmentId));
    }

    match /classes/{classId} {
      // Any logged-in professor can read class metadata (name, department, course,
      // lecture count) — needed so the "existing classes under this course" picker
      // works across professors. Student rosters and attendance records below
      // remain fully restricted to the owning professor, a collaborator, the
      // principal, or a creator.
      allow read: if request.auth != null;
      // Collaborators can edit the class (e.g. lecture count, syllabus meta)
      // just like the owner; the principal and a creator can too.
      allow update: if isOwnerOrCollaborator(resource.data) || isAdmin() || isCreator();
      // Only the owning professor, the principal, or a creator can delete
      // the class outright.
      allow delete: if request.auth != null &&
        (resource.data.professorId == request.auth.uid || isAdmin() || isCreator());
      allow create: if request.auth != null &&
        (request.resource.data.professorId == request.auth.uid || isCreator());
      match /students/{studentId} {
        allow read, write: if isOwnerOrCollaborator(
          get(/databases/$(database)/documents/classes/$(classId)).data) || isAdmin() || isCreator();
      }
      match /attendance_records/{dateStr} {
        allow read, write: if isOwnerOrCollaborator(
          get(/databases/$(database)/documents/classes/$(classId)).data) || isAdmin() || isCreator();
      }
      match /syllabus/{topicId} {
        allow read, write: if isOwnerOrCollaborator(
          get(/databases/$(database)/documents/classes/$(classId)).data) || isAdmin() || isCreator();
      }
    }

    // Public attendance view — lets a student check their own attendance with
    // no account at all. Each doc is keyed by "{RollNumber}_{last 5 phone
    // digits}" (built client-side, case-sensitive on the roll number), so a
    // read only succeeds if the caller already knows both pieces. `list` is
    // denied so the collection can never be browsed/enumerated wholesale —
    // only a single, already-known doc ID can be fetched. Writes happen only
    // from the app when a signed-in professor adds a student or submits
    // attendance, never from a student.
    match /publicView/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null;
    }

    // College notice board — announcements any signed-in professor can post,
    // readable by everyone (including signed-out visitors on the public home
    // screen). A professor may edit/delete only their own post; the principal
    // and a creator can moderate (delete) any of them. The ackCount-only
    // clause lets any visitor — including signed-out students — tap "Got it"
    // and bump the counter by exactly one, without being able to touch any
    // other field.
    match /announcements/{id} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid;
      allow update: if
        (request.auth != null && (resource.data.authorUid == request.auth.uid || isAdmin() || isCreator())) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackCount']) &&
         request.resource.data.ackCount == (resource.data.ackCount == null ? 0 : resource.data.ackCount) + 1);
      allow delete: if request.auth != null &&
        (resource.data.authorUid == request.auth.uid || isAdmin() || isCreator());
    }
  }
}
